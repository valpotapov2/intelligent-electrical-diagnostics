    "relationship": "requires_evidence_before_conclusion",
    "not_a_causal_model": true,
    "not_a_measurement_plan": true,
    "not_a_site_as_built_model": true,
    "unknowns_policy": "Do not infer equipment instances, wiring, terminals, ratings, settings, or physical test points."
